          "Width": 370.0,
          "Name": "SteeringLeft",
          "Bindings": {
            "Left": {
              "Formula": {
                "Interpreter": 1,
                "Expression": "var v=Number($prop('DataCorePlugin.GameRawData.Custom_SteeringInput')); if(!isFinite(v)||v>=0)return 460; return 460-Math.min(1,Math.abs(v))*370;"
              },
              "Mode": 2,
              "TargetPropertyName": "Left"
            },
            "Width": {
              "Formula": {
                "Interpreter": 1,
                "Expression": "var v=Number($prop('DataCorePlugin.GameRawData.Custom_SteeringInput')); return !isFinite(v)||v>=0 ? 0 : Math.min(1,Math.abs(v))*370;"
              },
              "Mode": 2,
              "TargetPropertyName": "Width"
            }
          }
        },
