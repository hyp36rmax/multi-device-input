              "Formula": {
                "Interpreter": 1,
                "Expression": "var v=Number($prop('DataCorePlugin.GameRawData.Custom_SteeringInput')); return !isFinite(v)||v<=0 ? 0 : Math.min(1,v)*370;"
              },
              "Mode": 2,
              "TargetPropertyName": "Width"
            }
          }
